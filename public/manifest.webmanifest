{
  "id": "/",
  "name": "FinTrack — Personal Finance Tracker",
  "short_name": "FinTrack",
  "description": "Track your income, expenses, budgets, and debts in one place. Split shared expenses with friends.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "theme_color": "#0b0b0f",
  "background_color": "#0b0b0f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    {
      "src": "/media/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/media/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/media/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/media/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add Transaction",
      "short_name": "Add",
      "description": "Quickly add a new income or expense",
      "url": "/?action=add",
      "icons": [{ "src": "/media/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Split Expenses",
      "short_name": "Split",
      "description": "Open FinTrack Split",
      "url": "/split",
      "icons": [{ "src": "/media/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Budgets",
      "short_name": "Budgets",
      "description": "View your budgets",
      "url": "/budgets",
      "icons": [{ "src": "/media/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Debts",
      "short_name": "Debts",
      "description": "View money owed and lent",
      "url": "/debt",
      "icons": [{ "src": "/media/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
